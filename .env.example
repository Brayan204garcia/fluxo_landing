# Resend API Key for sending emails
RESEND_API_KEY=your_resend_api_key_here

# Destination Email where contact notifications will be sent
CONTACT_EMAIL_TO=bratorres204@gmail.com

# Email Sender Address (Must be a verified domain in Resend, e.g. "Contacto <contacto@tuempresa.com>" or "onboarding@resend.dev" for testing)
CONTACT_EMAIL_FROM="Formulario Web <onboarding@resend.dev>"

# Cloudflare Turnstile CAPTCHA Keys (Optional but recommended)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
